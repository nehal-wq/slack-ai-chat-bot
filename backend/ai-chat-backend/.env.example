# Copy this file to .env and fill in your own values. Never commit .env.

# --- Server ---
PORT=5000
# Where the frontend is served; used for links in emails and allowed for CORS
FRONTEND_URL=http://localhost:5173
# Extra allowed frontend origins, comma-separated (optional)
CORS_ORIGINS=
# Reverse proxies in front of the app (1 on Render/Railway/Fly), for rate limits
TRUST_PROXY=0

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=slack_ai_workspace

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free

# --- Slack bot (optional) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

# --- Email for invites and sign-in links (Gmail: use an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Calls: TURN relay for strict networks (optional, comma-separated URLs) ---
# e.g. turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
